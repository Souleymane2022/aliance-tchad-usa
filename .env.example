# Copiez ce fichier vers .env puis remplissez les valeurs.

# Base de données PostgreSQL (Neon : https://neon.tech — gratuit).
# Sur le tableau de bord Neon, section "Connection Details" :
#  - DATABASE_URL : l'URL "Pooled connection" (contient "-pooler")
#  - DIRECT_URL   : l'URL directe (sans "-pooler"), utilisée pour les migrations
DATABASE_URL="postgresql://user:motdepasse@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:motdepasse@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clé secrète pour signer les sessions (générez-en une avec : openssl rand -base64 32)
AUTH_SECRET="changez-moi-avec-une-vraie-cle-secrete"
