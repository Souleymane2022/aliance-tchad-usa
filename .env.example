# Copiez ce fichier vers .env puis remplissez les valeurs.

# Base de données (SQLite par défaut ; remplacez par une URL PostgreSQL en production, ex. :
# DATABASE_URL="postgresql://user:motdepasse@hote:5432/alliance")
DATABASE_URL="file:./dev.db"

# Clé secrète pour signer les sessions (générez-en une avec : openssl rand -base64 32)
AUTH_SECRET="changez-moi-avec-une-vraie-cle-secrete"
